# =============================================================================
# local.env -- unico template de variaveis do projeto.
#
# Copie para `.env` NA RAIZ do repositorio e preencha. E de la que o Docker le,
# pelas duas vias que o Compose usa para variaveis:
#   env_file:  injeta no container      -> aponta para ../.env
#   ${VAR}:    substitui dentro do yml  -> o Makefile passa --env-file .env
#
# Sem o --env-file a segunda via procurava infra/.env, que nao existe, e toda
# ${VAR} caia no default calado -- foi o que deixou SCA_TOKEN_URL chegar vazia
# no container mesmo estando preenchida aqui.
#
# `.env` esta no .gitignore. Este arquivo e versionado e NAO deve ter segredo.
# =============================================================================


# ---------- Airflow ----------------------------------------------------------

AIRFLOW_UID=50000
AIRFLOW_HOME=/opt/airflow
AIRFLOW_VERSION=3.2.2
PYTHON_VERSION=3.11
# airflow-dev ou airflow-prod (estagios de infra/docker/airflow/Dockerfile)
AIRFLOW_BUILD_TARGET=airflow-dev

AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=<definir-senha>

# Criptografa password/extra das Connections e o valor das Variables.
# Gere com:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Use uma chave PROPRIA deste projeto. Reaproveitar a de outro repositorio
# funciona ate o dia em que alguem sobe o ambiente sem ela: tudo que estava
# criptografado vira lixo indecifravel. Trocar exige `airflow rotate-fernet-key`
# ANTES, senao Connections e Variables existentes se perdem.
AIRFLOW__CORE__FERNET_KEY=<gerar>

# Sem valor fixo, cada subprocesso do `airflow standalone` gera o seu proprio e
# as tasks falham com "Invalid auth token: Signature verification failed".
# Gere com: openssl rand -hex 32
AIRFLOW__API__SECRET_KEY=<gerar>
AIRFLOW__API_AUTH__JWT_SECRET=<gerar>

# Remove do banco de metadados as DAGs cujos arquivos foram apagados.
AIRFLOW_PRUNE_STALE_DAGS=true


# ---------- Postgres do Airflow (metadados, sobe no compose) ------------------

POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<definir-senha>
# Porta publicada no host. Mude se outro stack local ja ocupa a 5432 -- o
# Airflow usa a mesma para achar o banco de metadados (network_mode: host).
POSTGRES_PORT=5432


# ---------- Data Warehouse ---------------------------------------------------
#
# Estes nomes sao os que dbt/minc/profiles.yml le. Nao renomeie sem mudar la:
# o dbt cai nos defaults do profiles.yml e a conexao falha por autenticacao,
# sem dizer que a variavel estava com outro nome. E DB_DW_PASSWORD e
# DB_DW_DBNAME, nao DB_DW_PASS/DB_DW_DATABASE.

DB_DW_HOST=<preencher>
DB_DW_PORT=5432
DB_DW_USER=<preencher>
DB_DW_PASSWORD=<definir-senha>
DB_DW_DBNAME=<preencher>
DB_DW_SCHEMA=<preencher>


# ---------- OpenMetadata (openmetadata_ingestion_dag) ------------------------
#
# Host e tokens NAO ficam aqui: sao Variables do Airflow (OM_HOST,
# INGESTION_TOKEN, PROFILER_TOKEN, CLASSIFICATION_TOKEN), criadas na UI ou por
# `airflow variables import`.
#
# Estes flags ligam/desligam recipes e sao lidos no parse da DAG, entao mudar
# exige recriar o container. Uma recipe desligada nao vira task.

# Desligada: o MinC nao tem instancia propria de Superset.
OM_INGEST_SUPERSET=false
# Le o banco de metadados do Airflow. Desligue se falhar -- cataloga pipelines,
# nao tabelas, entao o catalogo de dados nao depende dela.
OM_INGEST_AIRFLOW=true
# O par que constroi o catalogo. Desligar um dos dois so faz sentido para
# isolar problema: sem eles a DAG nao cataloga nada.
OM_INGEST_POSTGRES=true
OM_INGEST_DBT=true
# Cria os termos que os schema.yml referenciam por FQN. Roda antes das recipes.
OM_INGEST_GLOSSARY=true
# Desligado: publica min, max e distribuicao, que sao estatisticas reveladoras
# num banco com CPF, CNPJ e dados de raca e deficiencia. Ligue so depois de
# verificar as exclusoes de coluna sensivel.
OM_INGEST_PROFILER=false
# Ligado: acha PII sem persistir amostra (`storeSampleData: false`).
OM_INGEST_CLASSIFIER=true
# Reaplica a governanca de dbt/minc/governance/ depois das recipes. E ela que
# devolve a certificacao que o conector dbt apaga.
OM_SYNC_GOVERNANCA=true
# Executa os testes nativos do OpenMetadata (formato, tabela vazia, colunas).
OM_INGEST_TESTSUITE=true
# Roda `dbt test` antes do conector dbt, para o resultado chegar ao catalogo e
# abrir incidente. O recorte padrao exclui a bronze do SALIC; para mudar, use
# OM_DBT_TEST_EXCLUDE (seletores do dbt separados por espaco).
OM_DBT_RUN_TESTS=true

# Precisam casar com serviceName/database das recipes, senao a linhagem
# publicada pelas DAGs aponta para tabelas que nao existem no catalogo.
OM_SERVICE=MinC
# O database do catalogo e o DB_DW_DBNAME, o mesmo que as recipes conectam.
# NAO declare OM_DATABASE aqui: ate 2026-10 este modelo trazia `minc`, o
# database antigo, e a linhagem e a governanca miravam 647 tabelas paradas
# enquanto o catalogo vivo estava em `dbanalytics`.
OM_PIPELINE_SERVICE=MinC - Airflow

# Projeto dbt que a recipe dbt_metadata consome, relativo a AIRFLOW_REPO_BASE.
# NAO chamar de DBT_PROJECT_DIR: esse nome e reservado pelo proprio dbt, que
# o le como --project-dir e passa a falhar em qualquer comando no container.
OM_DBT_PROJECT_DIR=dbt/minc


# ---------- MinIO ------------------------------------------------------------

MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=<definir-access-key>
MINIO_SECRET_KEY=<definir-secret>
MINIO_BUCKET=<preencher>
MINIO_REGION=us-east-1
MINIO_URL_STYLE=path
MINIO_USE_SSL=false
RAW_STORAGE_CONTAINER=<preencher>


# ---------- BSC / SERPRO (extracao_bbagil_dag) -------------------------------

SCA_TOKEN_URL=https://bsc.cultura.gov.br/sca/oauth/token
SCA_CLIENT_ID=<preencher>
SCA_CLIENT_SECRET=<definir-secret>
BSC_BASE_URL=https://bsc.cultura.gov.br
BSC_CPF_CONSULTA=<preencher>
BSC_USUARIO=minc.automacao
BSC_IP_ORIGEM=127.0.0.1
BSC_IP_USUARIO=127.0.0.1
BSC_MAX_CONCURRENT_REQUESTS=5
BSC_REQUEST_THROTTLE_SECONDS=1.05
BSC_CADUNICO_AUTHORIZATION_ID=<preencher>
BSC_CADUNICO_AUTHORIZATION_ID_TYPE=Processo
BSC_PNAB_DATA_DIR=/opt/airflow/data


# ---------- Transferegov -----------------------------------------------------
#
# A lista de programas a consultar vem da Variable "transferegov_programas_ids",
# nao daqui. Default do log: <BSC_PNAB_DATA_DIR>/transferegov/logs
TRANSFEREGOV_LOG_DIR=


# ---------- Trino (ingestao SALIC v2) ----------------------------------------
#
# O Trino le o ambiente do container via ${ENV:...} nos arquivos de
# infra/trino/etc/catalog/. Nenhum valor real entra em arquivo versionado.

TRINO_VERSION=478
TRINO_PORT=8090
# Heap da JVM = 80% deste limite. Terabyte nao exige heap grande (a copia e
# streaming, nao agregacao); subir isso ajuda mais quando ha muitas fatias em
# paralelo do que quando a tabela e grande.
TRINO_MEM_LIMIT=6g

# Destino (Postgres do data warehouse). Do container do Trino, o Postgres do
# compose responde por `postgres` -- nao por localhost.
TRINO_DW_HOST=postgres
TRINO_DW_PORT=5432
TRINO_DW_DB=<preencher>
TRINO_DW_USER=<preencher>
TRINO_DW_PASSWORD=<definir-senha>

# Origem (SQL Server do SALIC).
#
# NUNCA preencha aqui. Este arquivo e VERSIONADO num repositorio PUBLICO -- um
# valor real neste bloco vaza host, usuario e senha do SALIC, e continua no
# historico do git mesmo depois de removido. Os valores reais vao no `.env` da
# raiz, que esta no .gitignore.
#
# Um unico host serve os cinco bancos
# (SAC, Agentes, Tabelas, ControleDeAcesso, BDCorporativo). Se algum banco
# estiver em outro servidor, edite so o .properties daquele catalogo.
SALIC_MSSQL_HOST=<preencher>
SALIC_MSSQL_PORT=1433
SALIC_MSSQL_USER=<preencher>
SALIC_MSSQL_PASSWORD=<definir-senha>
SALIC_MSSQL_URL_OPTS=encrypt=false;trustServerCertificate=true;loginTimeout=30
# Dominio de busca da VPN. O container do Trino roda em rede bridge e nao
# herda o resolvedor do host, entao sem isto um nome curto de servidor nao
# resolve. Alternativa: usar o FQDN completo em SALIC_MSSQL_HOST.
SALIC_DNS_SEARCH=<preencher>


# ---------- MCP do Airflow (perfil dev) --------------------------------------

AF_READ_ONLY=false
